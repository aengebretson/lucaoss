@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/LucaTargets.cmake")

if("ingestion_sqlite" IN_LIST Luca_FIND_COMPONENTS OR "application_sqlite" IN_LIST Luca_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LucaIngestionSqliteTargets.cmake")
    include(CMakeFindDependencyMacro)
    find_dependency(SQLite3 3.38)
    find_dependency(nlohmann_json 3.12.0 EXACT CONFIG)
    find_dependency(Threads)
    include("${CMAKE_CURRENT_LIST_DIR}/LucaIngestionSqliteTargets.cmake")
    set(Luca_ingestion_sqlite_FOUND TRUE)
  else()
    set(Luca_ingestion_sqlite_FOUND FALSE)
  endif()
endif()
if("application_sqlite" IN_LIST Luca_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LucaApplicationSqliteTargets.cmake" AND Luca_ingestion_sqlite_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/LucaApplicationSqliteTargets.cmake")
    set(Luca_application_sqlite_FOUND TRUE)
  else()
    set(Luca_application_sqlite_FOUND FALSE)
  endif()
endif()
check_required_components(Luca)
