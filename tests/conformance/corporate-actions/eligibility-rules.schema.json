            "required": [
              "id",
              "version",
              "role",
              "calendar_id",
              "calendar_start",
              "calendar_end",
              "business_days",
              "timezone",
              "recognition_boundary",
              "approval",
              "effective_from",
              "foreign_security"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "customer",
                  "participant"
                ]
              },
              "calendar_id": {
                "type": "string",
                "minLength": 1
              },
              "calendar_start": {
                "type": "string",
                "format": "date"
              },
              "calendar_end": {
                "type": "string",
                "format": "date"
              },
              "business_days": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "date"
                },
                "minItems": 1
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "recognition_boundary": {
                "const": "start_of_ex_date"
              },
              "approval": {
                "const": "synthetic:fixture-only"
              },
              "effective_from": {
                "type": "string",
                "format": "date"
              },
              "foreign_security": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "announcement": {
            "type": "object",
            "required": [
              "action_id",
              "security_id",
              "announced_on",
              "record_on",
              "pay_on",
              "rate",
              "reference_price",
              "currency",
              "timely",
              "designated_ex_on",
              "designation_source_id"
