                "type": "string",
                "minLength": 1
              },
              "security_id": {
                "type": "string",
                "minLength": 1
              },
              "announced_on": {
                "type": "string",
                "format": "date"
              },
              "record_on": {
                "type": "string",
                "format": "date"
              },
              "pay_on": {
                "type": "string",
                "format": "date"
              },
              "rate": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"
              },
              "reference_price": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "timely": {
                "type": "boolean"
              },
              "designated_ex_on": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "designation_source_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
