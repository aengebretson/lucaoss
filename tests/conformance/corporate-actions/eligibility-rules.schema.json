                    "quantity": {
                      "type": "string",
                      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,8})?$"
                    },
                    "trade_on": {
                      "type": "string",
                      "format": "date"
                    },
                    "scheduled_delivery_on": {
                      "type": "string",
                      "format": "date"
                    },
                    "actual_delivery_on": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date"
                        },
                        {
                          "type": "null"
