      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "engine_support",
          "expectation_status",
          "decision_ids",
          "rule",
          "announcement",
          "inputs",
          "expected",
          "sources",
          "trace"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "engine_support": {
            "const": "unsupported"
          },
          "expectation_status": {
            "const": "conditional"
          },
          "decision_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "rule": {
