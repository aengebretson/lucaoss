              "market_rule_id": {
                "type": "string",
                "minLength": 1
              },
              "calendar_id": {
                "type": "string",
                "minLength": 1
              },
              "account_id": {
                "type": "string",
                "minLength": 1
              },
              "mapping_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luca:corporate-actions:eligibility-rules:1"
