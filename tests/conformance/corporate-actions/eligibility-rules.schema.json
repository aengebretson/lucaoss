            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "OK",
                  "EX_DATE_DESIGNATION_REQUIRED",
                  "ROUTE_POLICY_REQUIRED",
                  "CALENDAR_COVERAGE_REQUIRED"
                ]
              },
              "ex_on": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
