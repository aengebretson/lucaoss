                      ]
                    },
                    "route": {
                      "type": "string",
                      "enum": [
                        "regular",
                        "stock_loan",
                        "repo",
                        "cns",
                        "free",
                        "inter_depository"
                      ]
                    },
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "record_boundary": {
                "const": "end_of_record_date"
              },
              "ledger_through": {
                "type": "integer",
                "minimum": 0
              },
              "delivery_through": {
                "type": "integer",
                "minimum": 0
              },
