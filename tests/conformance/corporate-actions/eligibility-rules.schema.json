              "eligible_quantity": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,8})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "record_settled_quantity": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,8})?$"
              },
              "net_claim_quantity": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,8})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "gross": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observed_minus_computed": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "payload",
                "sha256"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "payload": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          },
          "trace": {
            "type": "object",
            "required": [
              "source_ids",
              "market_rule_id",
