set(prefix "${NATIVE_TEST_DIR}/install")
file(REMOVE_RECURSE "${NATIVE_TEST_DIR}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${LUCA_BINARY_DIR}" --prefix "${prefix}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native install failed: ${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${LUCA_SOURCE_DIR}/tests/ingestion/package_consumer" -B "${NATIVE_TEST_DIR}/build" -G "${GENERATOR}"
  "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_BUILD_TYPE=${BUILD_TYPE}" "-DCMAKE_PREFIX_PATH=${prefix};${DEPENDENCY_PREFIX}"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native consumer configure failed: ${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${NATIVE_TEST_DIR}/build" --parallel 2 RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native consumer build failed: ${error}")
endif()
execute_process(COMMAND "${NATIVE_TEST_DIR}/build/native_consumer" "${NATIVE_TEST_DIR}/data" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native consumer failed (${result}): ${error}")
endif()
message(STATUS "${output}")
